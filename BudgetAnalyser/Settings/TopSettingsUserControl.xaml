<UserControl x:Class="BudgetAnalyser.Settings.TopSettingsUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:settings="clr-namespace:BudgetAnalyser.Settings"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance settings:TopSettingsController}"
             Background="{StaticResource Brush.MainBackground}">

    <UserControl.Resources>
        <!-- One card per group of settings in BudgetAnalyserAppState.json -->
        <Style x:Key="Card.SettingsGroup"
               TargetType="{x:Type materialDesign:Card}">
            <Setter Property="Margin"
                    Value="0,0,0,16" />
            <Setter Property="Padding"
                    Value="16,12" />
            <Setter Property="materialDesign:ElevationAssist.Elevation"
                    Value="Dp1" />
        </Style>

        <Style x:Key="TextBlock.SettingsGroupHeading"
               TargetType="TextBlock"
               BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize"
                    Value="20" />
            <Setter Property="FontWeight"
                    Value="Medium" />
            <Setter Property="Foreground"
                    Value="{StaticResource Brush.Primary}" />
            <Setter Property="Margin"
                    Value="0,0,0,8" />
        </Style>

        <Style x:Key="TextBlock.SettingDescription"
               TargetType="TextBlock"
               BasedOn="{StaticResource TextBlock.Paragraph}">
            <Setter Property="Foreground"
                    Value="{StaticResource Brush.Text.Label}" />
            <Setter Property="TextWrapping"
                    Value="Wrap" />
            <Setter Property="Margin"
                    Value="2,0,2,8" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <!-- Cards stretch to a shared column so they are all the same width; capped so wide windows don't over-stretch them -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"
                                  MaxWidth="900" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="16">
                <TextBlock Style="{StaticResource TextBlock.PageTitle}"
                           Margin="0,0,0,4"
                           Text="Settings" />
                <TextBlock Style="{StaticResource TextBlock.SettingDescription}"
                           Margin="2,0,2,16"
                           Text="Settings are saved when Budget Analyser exits and read back at start-up." />

                <!-- Top level settings in the json file -->
                <materialDesign:Card Style="{StaticResource Card.SettingsGroup}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.ColumnSpan="2"
                                   Style="{StaticResource TextBlock.SettingsGroupHeading}"
                                   Text="General" />

                        <TextBlock Grid.Row="1"
                                   Style="{StaticResource TextBlock.LabelStyle}"
                                   Text="Last opened file" />
                        <TextBox Grid.Row="1"
                                 Grid.Column="1"
                                 Style="{StaticResource TextBox.ReadOnly}"
                                 Text="{Binding LastBaxFile, Mode=OneWay}" />
                        <TextBlock Grid.Row="2"
                                   Grid.Column="1"
                                   Style="{StaticResource TextBlock.SettingDescription}"
                                   Text="The Budget Analyser file opened automatically at start-up. This is updated to the currently open file when Budget Analyser exits." />
                    </Grid>
                </materialDesign:Card>

                <!-- ShellWindowState settings in the json file. Window size and position are not shown, they are captured on exit. -->
                <materialDesign:Card Style="{StaticResource Card.SettingsGroup}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.ColumnSpan="2"
                                   Style="{StaticResource TextBlock.SettingsGroupHeading}"
                                   Text="Transactions" />

                        <TextBlock Grid.Row="1"
                                   Style="{StaticResource TextBlock.LabelStyle}"
                                   Text="List page size" />
                        <TextBox Grid.Row="1"
                                 Grid.Column="1"
                                 Width="80"
                                 HorizontalAlignment="Left"
                                 Text="{Binding ListPageSize}" />
                        <TextBlock Grid.Row="2"
                                   Grid.Column="1"
                                   Style="{StaticResource TextBlock.SettingDescription}"
                                   Text="The number of rows shown per page in paginated lists, such as the Transactions list." />
                    </Grid>
                </materialDesign:Card>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
