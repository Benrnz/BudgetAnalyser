<Window x:Class="BudgetAnalyser.InputBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="200"
        ResizeMode="NoResize"
        Loaded="OnLoaded"
        Title="{Binding Heading}"
        Background="{StaticResource Brush.MainBackground}"
        Width="400"
        WindowStyle="SingleBorderWindow">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Margin="2"
                   Text="{Binding Question}"
                   TextWrapping="Wrap" />
        <TextBox x:Name="InputTextBox"
                 Grid.Row="1"
                 Margin="10"
                 Background="{StaticResource Brush.TileBackground}"
                 Text="{Binding Input}"
                 VerticalAlignment="Stretch"
                 VerticalScrollBarVisibility="Visible" />
        <StackPanel Grid.Row="2"
                    HorizontalAlignment="Right"
                    Margin="16,8,16,16"
                    Orientation="Horizontal">
            <Button Content="Cancel"
                    Style="{StaticResource Button.Dialog.Secondary}"
                    Click="OnCancelButtonClick" />
            <Button Content="OK"
                    Style="{StaticResource Button.Dialog.Primary}"
                    Click="OnOkButtonClick" />
        </StackPanel>
    </Grid>

</Window>
