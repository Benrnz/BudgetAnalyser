<UserControl x:Class="BudgetAnalyser.Matching.DisusedRulesUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:matching="clr-namespace:BudgetAnalyser.Matching"
             xmlns:matching1="clr-namespace:BudgetAnalyser.Engine.Matching;assembly=BudgetAnalyser.Engine"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance matching:DisusedRulesController}">

    <UserControl.Resources>
        <DataTemplate DataType="{x:Type matching:DisusedRuleViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Margin="3,10,3,10"
                        Command="{Binding RemoveCommand}"
                        CommandParameter="{Binding .}"
                        Style="{StaticResource Button.Round.SmallCross}" />
                <ContentPresenter Grid.Column="1"
                                  Content="{Binding MatchingRule}" />
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type matching1:MatchingRule}">
            <DataTemplate.Resources>
                <Style x:Key="TextBlock.MathcingRuleStyle"
                       BasedOn="{StaticResource {x:Type TextBlock}}"
                       TargetType="TextBlock">
                    <Setter Property="FontSize"
                            Value="18" />
                    <Setter Property="HorizontalAlignment"
                            Value="Left" />
                </Style>
                <Style x:Key="Border.DisusedRulePill"
                       TargetType="Border">
                    <Setter Property="Background"
                            Value="{StaticResource Brush.TileBackgroundAlternate}" />
                    <Setter Property="CornerRadius"
                            Value="12" />
                    <Setter Property="Padding"
                            Value="10,3" />
                    <Setter Property="Margin"
                            Value="10,3,10,3" />
                    <Setter Property="VerticalAlignment"
                            Value="Center" />
                </Style>
                <Style x:Key="TextBlock.DisusedRulePill"
                       BasedOn="{StaticResource {x:Type TextBlock}}"
                       TargetType="TextBlock">
                    <Setter Property="FontSize"
                            Value="13" />
                    <Setter Property="TextTrimming"
                            Value="CharacterEllipsis" />
                    <Setter Property="HorizontalAlignment"
                            Value="Center" />
                </Style>
            </DataTemplate.Resources>

            <Grid Visibility="{Binding Hidden, Converter={StaticResource Converter.NotBoolToVis}}"
                  HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Margin="10,3,10,3"
                           Style="{StaticResource TextBlock.MathcingRuleStyle}"
                           Text="{Binding MatchCount, StringFormat='x{0}'}"
                           ToolTip="{Binding LastMatch, StringFormat='Last matched: {0:g}'}" />

                <Border Grid.Column="1"
                        Background="{StaticResource Brush.BudgetBucket.Accumulated}"
                        Style="{StaticResource Border.DisusedRulePill}">
                    <TextBlock Style="{StaticResource TextBlock.DisusedRulePill}"
                               Text="{Binding Bucket.Code}"
                               ToolTip="Budget Bucket Code" />
                </Border>

                <UniformGrid Grid.Column="2"
                             Columns="4"
                             Rows="1">
                    <Border Style="{StaticResource Border.DisusedRulePill}"
                            ToolTip="Description">
                        <TextBlock Style="{StaticResource TextBlock.DisusedRulePill}"
                                   Text="{Binding Description}"
                                   ToolTip="Description" />
                    </Border>
                    <Border Style="{StaticResource Border.DisusedRulePill}"
                            ToolTip="Reference 1">
                        <TextBlock Style="{StaticResource TextBlock.DisusedRulePill}"
                                   Text="{Binding Reference1}"
                                   ToolTip="Reference 1" />
                    </Border>
                    <Border Style="{StaticResource Border.DisusedRulePill}"
                            ToolTip="Reference 2">
                        <TextBlock Style="{StaticResource TextBlock.DisusedRulePill}"
                                   Text="{Binding Reference2}"
                                   ToolTip="Reference 2" />
                    </Border>
                    <Border Style="{StaticResource Border.DisusedRulePill}"
                            ToolTip="Reference 3" >
                        <TextBlock Style="{StaticResource TextBlock.DisusedRulePill}"
                                   Text="{Binding Reference3}"
                                   ToolTip="Reference 3" />
                    </Border>
                </UniformGrid>
            </Grid>
        </DataTemplate>

    </UserControl.Resources>

    <Grid>
        <ListBox ItemContainerStyle="{StaticResource ListBox.NoVisualStatesContainerStyle}"
                 ItemsSource="{Binding DisusedRules}" />
    </Grid>
</UserControl>
