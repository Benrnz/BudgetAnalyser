<UserControl x:Class="BudgetAnalyser.Transactions.BankFeedImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:BudgetAnalyser.Transactions"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance views:BankFeedImportController}"
             Background="{StaticResource Brush.DialogBackground}">

    <!-- The download itself runs after this dialog closes; the dialog only gathers and validates the user's choice. -->
    <StackPanel Margin="50,0,50,0"
                MinWidth="560">
        <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource TextBlock.LabelStyle}"
                       Text="From" />
            <DatePicker Width="140"
                        Margin="8,0,24,0"
                        SelectedDate="{Binding FromDate, Converter={StaticResource Converter.DateOnly}}" />
            <TextBlock Style="{StaticResource TextBlock.LabelStyle}"
                       Text="To" />
            <DatePicker Width="140"
                        Margin="8,0,0,0"
                        SelectedDate="{Binding ToDate, Converter={StaticResource Converter.DateOnly}}" />
        </StackPanel>
        <TextBlock Style="{StaticResource TextBlock.Paragraph}"
                   TextWrapping="Wrap"
                   Text="{Binding SuggestionText}" />

        <StackPanel Orientation="Horizontal"
                    Margin="0,12,0,4">
            <TextBlock Style="{StaticResource TextBlock.LabelStyle}"
                       VerticalAlignment="Center"
                       Text="Accounts" />
            <Button Content="Refresh"
                    Style="{StaticResource Button.Dialog.Secondary}"
                    Height="24"
                    Padding="8,0"
                    Margin="16,0,0,0"
                    ToolTip="Ask the bank feed to fetch the latest transactions from your bank before you download."
                    Command="{Binding RefreshCommand}" />
            <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                         IsIndeterminate="True"
                         Width="16"
                         Height="16"
                         Margin="8,0,0,0"
                         VerticalAlignment="Center"
                         Visibility="{Binding IsRefreshing, Converter={StaticResource Converter.BoolToVis}}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal"
                    Visibility="{Binding IsLoading, Converter={StaticResource Converter.BoolToVis}}">
            <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                         IsIndeterminate="True"
                         Width="16"
                         Height="16"
                         Margin="0,0,8,0" />
            <TextBlock Style="{StaticResource TextBlock.Paragraph}"
                       Text="Checking the bank feed..." />
        </StackPanel>
        <ItemsControl ItemsSource="{Binding AccountRows}"
                      Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type views:BankFeedImportAccountRowViewModel}">
                    <StackPanel Margin="0,2">
                        <StackPanel Orientation="Horizontal">
                            <CheckBox IsChecked="{Binding IsSelected}"
                                      IsEnabled="{Binding IsAvailable}"
                                      VerticalAlignment="Center" />
                            <TextBlock Width="110"
                                       Margin="6,0,0,0"
                                       FontWeight="Medium"
                                       VerticalAlignment="Center"
                                       Text="{Binding AccountName}" />
                            <TextBlock Width="220"
                                       VerticalAlignment="Center"
                                       Text="{Binding FeedName}" />
                            <TextBlock Foreground="{StaticResource Brush.Text.Label}"
                                       VerticalAlignment="Center"
                                       Text="{Binding DataAsOfText}" />
                            <ContentControl Height="14"
                                            Margin="6,0,0,0"
                                            Template="{StaticResource WarningImage}"
                                            ToolTip="The bank feed's data for this account was refreshed before the end of your To date."
                                            Visibility="{Binding IsStale, Converter={StaticResource Converter.BoolToVis}}" />
                        </StackPanel>
                        <TextBlock Margin="28,0,0,0"
                                   Style="{StaticResource TextBlock.ValidationError}"
                                   Text="{Binding StatusText}" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Style="{StaticResource TextBlock.Paragraph}"
                   Margin="0,8,0,0"
                   TextWrapping="Wrap"
                   Text="{Binding RefreshStatus}"
                   Visibility="{Binding RefreshStatus, Converter={StaticResource Converter.NullToVis}, ConverterParameter=Collapsed}" />
        <TextBlock Style="{StaticResource TextBlock.Paragraph}"
                   Margin="0,8,0,0"
                   TextWrapping="Wrap"
                   Text="{Binding StaleWarning}"
                   Visibility="{Binding StaleWarning, Converter={StaticResource Converter.NullToVis}, ConverterParameter=Collapsed}" />
        <TextBlock Style="{StaticResource TextBlock.Paragraph}"
                   Margin="0,8,0,0"
                   TextWrapping="Wrap"
                   Text="{Binding OverlapWarning}"
                   Visibility="{Binding OverlapWarning, Converter={StaticResource Converter.NullToVis}, ConverterParameter=Collapsed}" />
        <TextBlock Style="{StaticResource TextBlock.ValidationError}"
                   Margin="0,8,0,0"
                   TextWrapping="Wrap"
                   Text="{Binding LoadError}" />
        <TextBlock Style="{StaticResource TextBlock.ValidationError}"
                   Margin="0,8,0,0"
                   TextWrapping="Wrap"
                   Text="{Binding ValidationMessage}" />
    </StackPanel>
</UserControl>
