<UserControl x:Class="BudgetAnalyser.Transactions.TopTransactionsUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:transactions="clr-namespace:BudgetAnalyser.Transactions"
             xmlns:root="clr-namespace:BudgetAnalyser"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             DataContextChanged="OnDataContextChanged"
             d:DataContext="{d:DesignInstance transactions:TopTransactionsListController}">

    <UserControl.Resources>

        <!-- Column headers: medium-emphasis labels. Horizontal margins match the row template's TextBlocks so the
             columns line up (see TransactionTemplate1 in TransactionListBox.xaml). -->
        <Style x:Key="TextBlock.ColumnHeader"
               TargetType="TextBlock"
               BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize"
                    Value="13" />
            <Setter Property="FontWeight"
                    Value="Medium" />
            <Setter Property="Foreground"
                    Value="{StaticResource Brush.Text.Label}" />
            <Setter Property="Margin"
                    Value="6,0,2,0" />
            <Setter Property="HorizontalAlignment"
                    Value="Left" />
        </Style>

        <!-- Empty states: a quiet icon, a title and supporting text, centred in the list area -->
        <Style x:Key="TextBlock.EmptyState.Title"
               TargetType="TextBlock"
               BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize"
                    Value="20" />
            <Setter Property="HorizontalAlignment"
                    Value="Center" />
            <Setter Property="Margin"
                    Value="0,16,0,8" />
        </Style>

        <Style x:Key="TextBlock.EmptyState.Body"
               TargetType="TextBlock"
               BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize"
                    Value="14" />
            <Setter Property="Foreground"
                    Value="{StaticResource Brush.Text.Label}" />
            <Setter Property="HorizontalAlignment"
                    Value="Center" />
            <Setter Property="TextAlignment"
                    Value="Center" />
            <Setter Property="TextWrapping"
                    Value="Wrap" />
            <Setter Property="MaxWidth"
                    Value="420" />
        </Style>

        <Style x:Key="PackIcon.EmptyState"
               TargetType="materialDesign:PackIcon">
            <Setter Property="Width"
                    Value="56" />
            <Setter Property="Height"
                    Value="56" />
            <Setter Property="HorizontalAlignment"
                    Value="Center" />
            <Setter Property="Foreground"
                    Value="{StaticResource Brush.Text.Disabled}" />
        </Style>

    </UserControl.Resources>

    <Grid Background="{StaticResource Brush.MainBackground}">
        <Grid.RowDefinitions>
            <!-- Header bar & Tool bar -->
            <RowDefinition Height="Auto" />
            <!-- Summary chips & Navigation bar -->
            <RowDefinition Height="Auto" />
            <!-- Transaction List -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- Header bar & Tool bar -->
        <Grid Margin="0,8,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- Header bar: Heading1 adds its own 10px left margin, giving a 16px page inset -->
            <StackPanel Margin="6,0,0,0"
                        Orientation="Horizontal">
                <TextBlock Style="{StaticResource TextBlock.Heading1}"
                           Text="{Binding ViewModel.TransactionListModelName}" />
                <TextBlock Style="{StaticResource TextBlock.Heading1}"
                           Margin="2"
                           Text="*"
                           ToolTip="There are unsaved changes"
                           Visibility="{Binding ViewModel.Dirty, Converter={StaticResource Converter.BoolToVis}}" />
            </StackPanel>
            <!-- Toolbar -->
            <StackPanel Grid.Row="0"
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Grid Margin="0,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchTextBox"
                             GotFocus="OnSearchTextBoxGotFocus"
                             LostFocus="OnSearchTextBoxLostFocus"
                             MinWidth="27"
                             Text="{Binding TextFilter, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Search for text within a transaction"
                             Width="27" />
                    <ContentControl Grid.Column="0"
                                    Template="{StaticResource SearchImage}"
                                    IsHitTestVisible="False"
                                    HorizontalAlignment="Right"
                                    Margin="0,0,7,0"
                                    Height="17"
                                    Width="17"
                                    Visibility="{Binding TextFilter, Converter={StaticResource Converter.NotNullToVis}, ConverterParameter=Empty}" />
                    <Button x:Name="ClearSearchButton"
                            Grid.Column="1"
                            Style="{StaticResource Button.Round.SmallCross}"
                            Command="{Binding ClearSearchCommand}"
                            IsEnabled="{Binding TextFilter, Converter={StaticResource Converter.NotNullIsTrue}}"
                            Width="0" />
                    <ComboBox x:Name="BucketFilterComboBox"
                              DropDownClosed="OnBucketFilterComboBoxDropDownClosed"
                              DropDownOpened="OnBucketFilterComboBoxDropDownOpened"
                              Grid.Column="2"
                              ItemContainerStyle="{StaticResource BudgetBucketComboItemStyle}"
                              ItemsSource="{Binding ViewModel.FilterBudgetBuckets}"
                              Margin="8,0,0,0"
                              MinWidth="37"
                              SelectedItem="{Binding BucketFilter}"
                              ToolTip="Budget Bucket Filter"
                              Width="37" />
                    <ContentControl Grid.Column="2"
                                    Height="17"
                                    HorizontalAlignment="Right"
                                    IsHitTestVisible="False"
                                    Margin="0,0,16,0"
                                    Template="{StaticResource Filter2Image}"
                                    Visibility="{Binding BucketFilter, Converter={StaticResource Converter.NotNullToVis}, ConverterParameter=Empty}"
                                    Width="17" />
                </Grid>
                <Button Command="{Binding EditRulesController.ShowRulesCommand}"
                        Style="{StaticResource Button.Round.EditRules}"
                        ToolTip="Show and edit all matching rules" />
                <Button Command="{Binding AppliedRulesController.ApplyRulesCommand}"
                        CommandParameter="{Binding ViewModel.TransactionsList}"
                        Style="{StaticResource Button.Round.ApplyRules}"
                        ToolTip="Apply Matching Rules to unassigned transactions" />
                <Button Command="{x:Static root:PersistenceOperationCommands.SaveDatabaseCommand}"
                        Style="{StaticResource Button.Round.Save}"
                        ToolTip="Save Transactions (Ctrl+S)" />
                <Button Command="{Binding MergeBankExtractCommand}"
                        Style="{StaticResource Button.Round.Add}"
                        ToolTip="Merge in new Transactions. This will also save any unsaved changes before merging new transactions." />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1"
              Margin="16,0,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- Summary chips -->
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        SnapsToDevicePixels="True">
                <StackPanel Margin="0,0,16,0"
                            Orientation="Horizontal"
                            Visibility="{Binding FileOperations.LoadingData, Converter={StaticResource Converter.BoolToVis}}">
                    <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                 IsIndeterminate="True"
                                 Width="20"
                                 Height="20"
                                 Margin="0,0,8,0" />
                    <TextBlock FontSize="14"
                               Foreground="{StaticResource Brush.Text.Label}"
                               Text="Loading data..." />
                </StackPanel>
                <Border Style="{StaticResource Border.SummaryChip.Info}"
                        ToolTip="Total Credits currently displayed.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource TextBlock.SummaryChip.Info.Label}"
                                   Text="CR" />
                        <TextBlock Foreground="{StaticResource Brush.Positive.Text}"
                                   Style="{StaticResource TextBlock.SummaryChip.Info.Value}"
                                   Text="{Binding ViewModel.TotalCredits, StringFormat=C}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Border.SummaryChip.Info}"
                        ToolTip="Total debits currently displayed.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource TextBlock.SummaryChip.Info.Label}"
                                   Text="DR" />
                        <TextBlock Foreground="{StaticResource Brush.Negative.Text}"
                                   Style="{StaticResource TextBlock.SummaryChip.Info.Value}"
                                   Text="{Binding ViewModel.TotalDebits, StringFormat=C}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Border.SummaryChip.Info}"
                        ToolTip="Difference between total displayed credits and total displayed debits.">
                    <StackPanel Orientation="Horizontal">
                        <ContentControl Height="14"
                                        Margin="0,0,8,0"
                                        Opacity="0.6"
                                        Template="{StaticResource DeltaImage}"
                                        Width="14" />
                        <TextBlock Foreground="{Binding ViewModel.TotalDifference, Converter={StaticResource Converter.NumberToBrush}, ConverterParameter=Light}"
                                   Style="{StaticResource TextBlock.SummaryChip.Info.Value}"
                                   Text="{Binding ViewModel.TotalDifference, StringFormat=C}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Border.SummaryChip.Info}"
                        ToolTip="The number of transactions currently displayed.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,8,0"
                                   Style="{StaticResource TextBlock.SummaryChip.Info.Value}"
                                   Text="{Binding ViewModel.TotalCount}" />
                        <TextBlock Margin="0"
                                   Style="{StaticResource TextBlock.SummaryChip.Info.Label}"
                                   Text="Transactions" />
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource Brush.Negative.Container}"
                        Style="{StaticResource Border.SummaryChip}"
                        ToolTip="Potentially corrupt data exists in the transactions. Some transactions appear as exact duplicates of others. Look for red highlighted rows."
                        Visibility="{Binding ViewModel.DuplicateSummary, Converter={StaticResource Converter.NullToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="AlertOutline"
                                                 Width="16"
                                                 Height="16"
                                                 Margin="0,0,8,0"
                                                 VerticalAlignment="Center"
                                                 Foreground="{StaticResource Brush.BadgeText}" />
                        <TextBlock Style="{StaticResource TextBlock.SummaryChip.Label}"
                                   Margin="0"
                                   Text="{Binding ViewModel.DuplicateSummary}" />
                    </StackPanel>
                </Border>
            </StackPanel>
            <!-- Navigation bar -->
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        SnapsToDevicePixels="True"
                        HorizontalAlignment="Right">
                <Button Style="{StaticResource Button.Round.Left}"
                        IsEnabled="{Binding CanNavigatePrevious}"
                        Command="{Binding NavigatePreviousPageCommand}"
                        ToolTip="Previous Page" />
                <Button Style="{StaticResource Button.Round.Right}"
                        Command="{Binding NavigateNextPageCommand}"
                        IsEnabled="{Binding CanNavigateNext}"
                        ToolTip="Next Page" />
            </StackPanel>
        </Grid>

        <!-- Transaction List -->
        <Grid Grid.Column="0"
              Grid.Row="2"
              Margin="16,0,16,16"
              IsSharedSizeScope="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Column headers. The left margin matches the list item's margin + padding so the columns line up. -->
            <Border BorderBrush="{StaticResource Brush.ControlBorder}"
                    BorderThickness="0,0,0,1"
                    Padding="9,0,0,8"
                    Visibility="{Binding ViewModel.HasTransactions, Converter={StaticResource Converter.BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition SharedSizeGroup="A"
                                          Width="Auto" />
                        <ColumnDefinition SharedSizeGroup="B"
                                          Width="Auto" />
                        <ColumnDefinition SharedSizeGroup="C"
                                          Width="Auto" />
                        <ColumnDefinition SharedSizeGroup="D"
                                          Width="Auto" />
                        <ColumnDefinition SharedSizeGroup="E"
                                          Width="Auto" />
                        <ColumnDefinition SharedSizeGroup="F"
                                          Width="Auto" />
                        <ColumnDefinition SharedSizeGroup="G"
                                          Width="Auto" />
                        <ColumnDefinition SharedSizeGroup="H"
                                          Width="Auto" />
                        <ColumnDefinition SharedSizeGroup="I"
                                          Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Style="{StaticResource TextBlock.ColumnHeader}"
                               Text="Date" />
                    <TextBlock Grid.Column="1"
                               Margin="6,0,6,0"
                               HorizontalAlignment="Right"
                               Style="{StaticResource TextBlock.ColumnHeader}"
                               Text="Amount" />
                    <TextBlock Grid.Column="2"
                               Style="{StaticResource TextBlock.ColumnHeader}"
                               Text="Description" />
                    <TextBlock Grid.Column="3"
                               Style="{StaticResource TextBlock.ColumnHeader}"
                               Text="Bucket" />
                    <TextBlock Grid.Column="4"
                               Style="{StaticResource TextBlock.ColumnHeader}"
                               Text="Reference 1" />
                    <TextBlock Grid.Column="5"
                               Style="{StaticResource TextBlock.ColumnHeader}"
                               Text="Reference 2" />
                    <TextBlock Grid.Column="6"
                               Style="{StaticResource TextBlock.ColumnHeader}"
                               Text="Reference 3" />
                    <TextBlock Grid.Column="7"
                               Style="{StaticResource TextBlock.ColumnHeader}"
                               Text="Type" />
                    <TextBlock Grid.Column="8"
                               Margin="5,0,5,0"
                               Style="{StaticResource TextBlock.ColumnHeader}"
                               Text="Account" />
                </Grid>
            </Border>

            <!-- Empty states -->
            <Grid Grid.Row="1"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
                <StackPanel Visibility="{Binding ViewModel.TransactionsList, Converter={StaticResource Converter.NullToVis}}">
                    <StackPanel Visibility="{Binding ViewModel.HasTransactions, Converter={StaticResource Converter.NotBoolToVis}}">
                        <materialDesign:PackIcon Kind="FilterRemoveOutline"
                                                 Style="{StaticResource PackIcon.EmptyState}" />
                        <TextBlock Style="{StaticResource TextBlock.EmptyState.Title}"
                                   Text="No transactions match the current filter" />
                        <TextBlock Style="{StaticResource TextBlock.EmptyState.Body}"
                                   Text="Widen the global date filter on the Dashboard, or clear the search and bucket filters to show every transaction." />
                    </StackPanel>
                </StackPanel>
                <StackPanel Visibility="{Binding ViewModel.TransactionsList, Converter={StaticResource Converter.NotNullToVis}}">
                    <materialDesign:PackIcon Kind="FileDocumentOutline"
                                             Style="{StaticResource PackIcon.EmptyState}" />
                    <TextBlock Style="{StaticResource TextBlock.EmptyState.Title}"
                               Text="No transactions file loaded" />
                    <TextBlock Style="{StaticResource TextBlock.EmptyState.Body}"
                               Text="Open or create a Budget Analyser file from the Dashboard to see its transactions here." />
                </StackPanel>
            </Grid>

            <ListBox x:Name="TransactionListBox"
                     AlternationCount="2"
                     Grid.Row="1"
                     IsTextSearchEnabled="False"
                     ItemContainerStyle="{StaticResource ListBox.TransactionContainer}"
                     ItemsSource="{Binding ViewModel.PagedTransactions}"
                     ItemTemplate="{StaticResource TransactionTemplate1}"
                     KeyUp="OnTransactionListBoxKeyUp"
                     MinHeight="95"
                     MinWidth="120"
                     MouseDoubleClick="OnTransactionListBoxDoubleClick"
                     SelectedItem="{Binding ViewModel.SelectedRow}"
                     SelectionMode="Single"
                     VirtualizingPanel.IsVirtualizing="False"
                     Visibility="{Binding ViewModel.HasTransactions, Converter={StaticResource Converter.BoolToVis}}">
                <ListBox.ContextMenu>
                    <ContextMenu HasDropShadow="true"
                                 d:DataContext="{d:DesignInstance transactions:TopTransactionsListController}">
                        <ContextMenu.Resources>
                            <Style BasedOn="{StaticResource TextBlock.ContextMenuStyle}"
                                   TargetType="{x:Type TextBlock}" />
                        </ContextMenu.Resources>
                        <MenuItem Command="{Binding AppliedRulesController.CreateRuleCommand}"
                                  CommandParameter="{Binding ViewModel.SelectedRow}">
                            <MenuItem.Header>
                                <TextBlock Text="Create Rule" />
                            </MenuItem.Header>
                        </MenuItem>
                        <Separator />
                        <MenuItem Command="{Binding EditTransactionCommand}">
                            <MenuItem.Header>
                                <TextBlock Text="Edit Transaction" />
                            </MenuItem.Header>
                        </MenuItem>
                        <MenuItem Command="{Binding EditingTransactionController.DeleteTransactionCommand}"
                                  CommandParameter="{Binding ViewModel.SelectedRow}">
                            <MenuItem.Header>
                                <TextBlock Text="Delete Transaction" />
                            </MenuItem.Header>
                        </MenuItem>
                        <MenuItem Command="{Binding SplitTransactionCommand}">
                            <MenuItem.Header>
                                <TextBlock Text="Split Transaction" />
                            </MenuItem.Header>
                        </MenuItem>
                    </ContextMenu>
                </ListBox.ContextMenu>
            </ListBox>
        </Grid>
    </Grid>

</UserControl>
