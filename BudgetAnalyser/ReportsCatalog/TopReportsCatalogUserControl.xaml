<UserControl x:Class="BudgetAnalyser.ReportsCatalog.TopReportsCatalogUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:reportsCatalog="clr-namespace:BudgetAnalyser.ReportsCatalog"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance reportsCatalog:TopReportsCatalogController}"
             Background="{StaticResource Brush.MainBackground}">

    <UserControl.Resources>
        <!-- Report tiles look like dashboard tiles. The base tile style lifts on hover based on a widget's Clickable
             property; report tiles aren't widgets, so availability drives the hover and disabled states instead. -->
        <Style x:Key="Card.ReportTile"
               TargetType="{x:Type materialDesign:Card}"
               BasedOn="{StaticResource ModernTileMediumStyle1}">
            <Setter Property="Foreground"
                    Value="{StaticResource Brush.Text.Default}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding OverallPerformanceReportIsAvailable}"
                             Value="False">
                    <Setter Property="Background"
                            Value="{StaticResource Brush.ModernTile.Disabled}" />
                    <Setter Property="Foreground"
                            Value="{StaticResource Brush.Text.Disabled}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}"
                                   Value="True" />
                        <Condition Binding="{Binding OverallPerformanceReportIsAvailable}"
                                   Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="materialDesign:ElevationAssist.Elevation"
                            Value="Dp8" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- Tiles have a 10px top and left margin, so this gives a 16px page inset -->
    <StackPanel Margin="6,6,16,16">
        <WrapPanel Orientation="Horizontal">
            <materialDesign:Card Style="{StaticResource Card.ReportTile}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <materialDesign:PackIcon Kind="ChartBar"
                                             Width="40"
                                             Height="40"
                                             Margin="8"
                                             Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=materialDesign:Card}}" />
                    <TextBlock Grid.Row="1"
                               Margin="4,0,4,4"
                               Style="{StaticResource TextBlock.Widget.Paragraph}"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=materialDesign:Card}}"
                               Text="{Binding OverallPerformanceController.Title}"
                               TextWrapping="Wrap" />
                    <Button Click="OverallPerformanceClicked"
                            Grid.RowSpan="2"
                            IsEnabled="{Binding OverallPerformanceReportIsAvailable}"
                            Style="{StaticResource Button.ModernTile.Overlay}" />
                </Grid>
            </materialDesign:Card>
        </WrapPanel>

        <!-- Say why the reports are unavailable on screen, not in a tooltip -->
        <TextBlock Margin="10,16,0,0"
                   FontSize="14"
                   Foreground="{StaticResource Brush.Text.Label}"
                   Text="Reports need transactions and a current budget. Open a Budget Analyser file that has both from the Dashboard."
                   TextWrapping="Wrap"
                   Visibility="{Binding OverallPerformanceReportIsAvailable, Converter={StaticResource Converter.NotBoolToVis}}" />
    </StackPanel>

</UserControl>
