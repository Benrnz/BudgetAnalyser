<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:transactions="clr-namespace:BudgetAnalyser.Transactions">

    <Style x:Key="{x:Type ComboBox}"
           TargetType="{x:Type ComboBox}"
           BasedOn="{StaticResource MaterialDesignComboBox}">
        <Setter Property="MinWidth"
                Value="120" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="TextBlock.Foreground"
                Value="{StaticResource Brush.Text.Default}" />
        <Setter Property="Margin"
                Value="2" />
    </Style>

    <Style x:Key="BudgetBucketComboItemStyle"
           TargetType="{x:Type ComboBoxItem}"
           BasedOn="{StaticResource MaterialDesignComboBoxItemStyle}">
        <Setter Property="ToolTip"
                Value="{Binding Description}" />
    </Style>

    <Style x:Key="BudgetBucketComboStyle"
           TargetType="ComboBox"
           BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="Background"
                Value="{StaticResource Brush.MainBackground}" />
        <Setter Property="DisplayMemberPath"
                Value="Code" />
        <Setter Property="HorizontalAlignment"
                Value="Left" />
        <Setter Property="ItemContainerStyle"
                Value="{StaticResource BudgetBucketComboItemStyle}" />
        <Setter Property="VerticalAlignment"
                Value="Top" />
        <Setter Property="Width"
                Value="130" />
    </Style>

    <Style x:Key="ComboBox.Account"
           BasedOn="{StaticResource {x:Type ComboBox}}"
           TargetType="ComboBox">
        <Setter Property="Width"
                Value="130" />
        <Setter Property="ItemTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Viewbox MaxHeight="35">
                        <transactions:AccountUserControl Focusable="False"
                                                         IsHitTestVisible="False"
                                                         IsTabStop="False" />
                    </Viewbox>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
