<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Palette (Material Design dark theme). Every colour in the app should come from this list.
        Each hue has two tones:
          - a light tone for text, icons and accents drawn directly on dark surfaces;
          - a container tone for fills. Text on a coloured fill is always light (Colour.Palette.TextHigh),
            and every container tone gives at least WCAG AA (4.5:1) contrast with it.
    -->

    <!-- Surfaces, following Material's dark-theme elevation steps -->
    <Color x:Key="Colour.Palette.Background">#FF121212</Color>       <!-- 0dp -->
    <Color x:Key="Colour.Palette.Surface">#FF1E1E1E</Color>          <!-- 1dp -->
    <Color x:Key="Colour.Palette.SurfaceRaised">#FF2C2C2C</Color>    <!-- 6dp -->
    <Color x:Key="Colour.Palette.Dialog">#FF383838</Color>           <!-- 24dp -->
    <Color x:Key="Colour.Palette.Divider">#1FFFFFFF</Color>          <!-- white 12% -->
    <Color x:Key="Colour.Palette.Tooltip">#FF616161</Color>          <!-- Grey 700 -->

    <!-- Text on surfaces: white at Material's high / medium / disabled emphasis -->
    <Color x:Key="Colour.Palette.TextHigh">#DEFFFFFF</Color>
    <Color x:Key="Colour.Palette.TextMedium">#99FFFFFF</Color>
    <Color x:Key="Colour.Palette.TextDisabled">#61FFFFFF</Color>

    <!-- Primary (brand): Teal 200 / Teal 800 -->
    <Color x:Key="Colour.Palette.Primary">#FF80CBC4</Color>
    <Color x:Key="Colour.Palette.PrimaryContainer">#FF00695C</Color>

    <!-- Positive (credit, surplus, income, under budget): Green 300 / Green 900 -->
    <Color x:Key="Colour.Palette.Positive">#FF81C784</Color>
    <Color x:Key="Colour.Palette.PositiveContainer">#FF1B5E20</Color>

    <!-- Negative (debit, overspent, errors): Red 200 / Red 900 -->
    <Color x:Key="Colour.Palette.Negative">#FFEF9A9A</Color>
    <Color x:Key="Colour.Palette.NegativeContainer">#FFB71C1C</Color>

    <!-- Warning (needs attention, saved-up buckets). Orange 900 fails AA with light text, so this is darkened slightly. -->
    <Color x:Key="Colour.Palette.WarningContainer">#FFA64B00</Color>

    <!-- Info (second tile colour): Blue 800 -->
    <Color x:Key="Colour.Palette.InfoContainer">#FF1565C0</Color>


    <!-- Semantic brushes. Keys are referenced by name from views, converters and BudgetAnalyser.Engine widgets. -->

    <!-- Surfaces -->
    <SolidColorBrush x:Key="Brush.MainBackground"
                     Color="{StaticResource Colour.Palette.Background}" />

    <SolidColorBrush x:Key="Brush.SecondaryBackground"
                     Color="{StaticResource Colour.Palette.Surface}" />

    <SolidColorBrush x:Key="Brush.TileBackgroundAlternate"
                     Color="{StaticResource Colour.Palette.Surface}" />

    <SolidColorBrush x:Key="Brush.TileBackground"
                     Color="{StaticResource Colour.Palette.SurfaceRaised}" />

    <SolidColorBrush x:Key="Brush.NeutralNumberBackground"
                     Color="{StaticResource Colour.Palette.SurfaceRaised}" />

    <SolidColorBrush x:Key="Brush.DialogBackground"
                     Color="{StaticResource Colour.Palette.Dialog}" />

    <SolidColorBrush x:Key="Brush.ToolTip.Background"
                     Color="{StaticResource Colour.Palette.Tooltip}" />

    <SolidColorBrush x:Key="Brush.BorderLight"
                     Color="{StaticResource Colour.Palette.Divider}" />

    <SolidColorBrush x:Key="Brush.ControlBorder"
                     Color="{StaticResource Colour.Palette.Divider}" />

    <!-- Used as a translucent shading overlay (e.g. report progress bars), not as a colour in its own right -->
    <SolidColorBrush x:Key="Brush.Shadow"
                     Color="Black" />

    <!-- Text -->
    <SolidColorBrush x:Key="Brush.Text.Default"
                     Color="{StaticResource Colour.Palette.TextHigh}" />

    <SolidColorBrush x:Key="Brush.Text.Label"
                     Color="{StaticResource Colour.Palette.TextMedium}" />

    <SolidColorBrush x:Key="Brush.Text.Disabled"
                     Color="{StaticResource Colour.Palette.TextDisabled}" />

    <SolidColorBrush x:Key="Brush.BadgeText"
                     Color="{StaticResource Colour.Palette.TextHigh}" />

    <SolidColorBrush x:Key="Brush.Positive.Text"
                     Color="{StaticResource Colour.Palette.Positive}" />

    <SolidColorBrush x:Key="Brush.Negative.Text"
                     Color="{StaticResource Colour.Palette.Negative}" />

    <!-- Errors, validation messages and warning glyphs drawn on surfaces -->
    <SolidColorBrush x:Key="Brush.ImportantHighlightLight"
                     Color="{StaticResource Colour.Palette.Negative}" />

    <!-- Primary -->
    <SolidColorBrush x:Key="Brush.Primary.Container"
                     Color="{StaticResource Colour.Palette.PrimaryContainer}" />

    <SolidColorBrush x:Key="Brush.Button.Background"
                     Color="{StaticResource Colour.Palette.PrimaryContainer}" />

    <SolidColorBrush x:Key="Brush.Button.Stroke"
                     Color="{StaticResource Colour.Palette.PrimaryContainer}" />

    <SolidColorBrush x:Key="Brush.Button.Glyph"
                     Color="White" />

    <!-- Active tab indicator -->
    <SolidColorBrush x:Key="Brush.ModernTile.Highlight"
                     Color="{StaticResource Colour.Palette.Primary}" />

    <!-- Status fills (container tones, always with light text) -->
    <SolidColorBrush x:Key="Brush.CreditBackground1"
                     Color="{StaticResource Colour.Palette.PositiveContainer}" />

    <SolidColorBrush x:Key="Brush.DebitBackground1"
                     Color="{StaticResource Colour.Palette.NegativeContainer}" />

    <SolidColorBrush x:Key="Brush.Negative.Container"
                     Color="{StaticResource Colour.Palette.NegativeContainer}" />

    <SolidColorBrush x:Key="Brush.NotSoBadDebit"
                     Color="{StaticResource Colour.Palette.WarningContainer}" />

    <SolidColorBrush x:Key="Brush.WarningOilLight"
                     Color="{StaticResource Colour.Palette.WarningContainer}" />

    <SolidColorBrush x:Key="Brush.RedOilLight"
                     Color="{StaticResource Colour.Palette.NegativeContainer}" />

    <!-- Budget bucket types -->
    <SolidColorBrush x:Key="Brush.BudgetBucket.Income"
                     Color="{StaticResource Colour.Palette.PositiveContainer}" />

    <SolidColorBrush x:Key="Brush.BudgetBucket.SpentMonthly"
                     Color="{StaticResource Colour.Palette.NegativeContainer}" />

    <SolidColorBrush x:Key="Brush.BudgetBucket.Accumulated"
                     Color="{StaticResource Colour.Palette.WarningContainer}" />

    <!-- Dashboard tiles -->
    <SolidColorBrush x:Key="Brush.ModernTile.Background1"
                     Color="{StaticResource Colour.Palette.PrimaryContainer}" />

    <SolidColorBrush x:Key="Brush.ModernTile.Background2"
                     Color="{StaticResource Colour.Palette.InfoContainer}" />

    <SolidColorBrush x:Key="Brush.ModernTile.Background3"
                     Color="{StaticResource Colour.Palette.SurfaceRaised}" />

    <SolidColorBrush x:Key="Brush.ModernTile.Disabled"
                     Color="{StaticResource Colour.Palette.Surface}" />
</ResourceDictionary>
