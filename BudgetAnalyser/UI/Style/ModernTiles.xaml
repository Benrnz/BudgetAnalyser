<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <!-- Invisible click target laid over a tile. Hover feedback is a Material state layer (a light overlay, which reads
         far better than a shadow change on a dark theme) plus the tile's elevation change (see
         ModernTileMediumBaseStyle). Press feedback is a Material ripple. -->
    <Style x:Key="Button.ModernTile.Overlay"
           TargetType="{x:Type Button}">
        <Setter Property="HorizontalAlignment"
                Value="Stretch" />
        <Setter Property="VerticalAlignment"
                Value="Stretch" />
        <Setter Property="Cursor"
                Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid Background="Transparent">
                        <Border x:Name="HoverStateLayer"
                                Background="{StaticResource Brush.Text.Default}"
                                Opacity="0" />
                        <materialDesign:Ripple Feedback="{StaticResource Brush.Text.Default}"
                                               Focusable="False"
                                               HorizontalContentAlignment="Stretch"
                                               VerticalContentAlignment="Stretch">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </materialDesign:Ripple>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="HoverStateLayer"
                                    Property="Opacity"
                                    Value="0.12" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tile styles are referenced by key name from BudgetAnalyser.Engine widgets (Widget.WidgetStyle), so the keys
         must not change. -->
    <Style x:Key="ModernTileMediumBaseStyle"
           TargetType="{x:Type materialDesign:Card}"
           BasedOn="{StaticResource MaterialDesignElevatedCard}">
        <Setter Property="Height"
                Value="100" />
        <Setter Property="Width"
                Value="200" />
        <Setter Property="Margin"
                Value="10,10,0,0" />
        <Setter Property="Padding"
                Value="0" />
        <Setter Property="UniformCornerRadius"
                Value="4" />
        <Setter Property="ClipContent"
                Value="True" />
        <Setter Property="materialDesign:ElevationAssist.Elevation"
                Value="Dp2" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Enabled}"
                         Value="False">
                <Setter Property="Background"
                        Value="{StaticResource Brush.ModernTile.Disabled}" />
            </DataTrigger>
            <!-- Lift clickable tiles on hover -->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}"
                               Value="True" />
                    <Condition Binding="{Binding Clickable}"
                               Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="materialDesign:ElevationAssist.Elevation"
                        Value="Dp8" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ModernTileMediumStyle1"
           TargetType="{x:Type materialDesign:Card}"
           BasedOn="{StaticResource ModernTileMediumBaseStyle}">
        <Setter Property="Background"
                Value="{StaticResource Brush.ModernTile.Background1}" />
    </Style>

    <Style x:Key="ModernTileMediumStyle2"
           TargetType="{x:Type materialDesign:Card}"
           BasedOn="{StaticResource ModernTileMediumBaseStyle}">
        <Setter Property="Background"
                Value="{StaticResource Brush.ModernTile.Background2}" />
    </Style>

    <Style x:Key="ModernTileSmallStyle1"
           TargetType="{x:Type materialDesign:Card}"
           BasedOn="{StaticResource ModernTileMediumStyle1}">
        <Setter Property="Width"
                Value="100" />
    </Style>

    <Style x:Key="WidgetWarningStyle"
           TargetType="Panel">
        <Setter Property="Background"
                Value="{StaticResource Brush.WarningOilLight}" />
    </Style>

    <Style x:Key="WidgetStandardStyle"
           TargetType="Panel">
        <Setter Property="Background"
                Value="{StaticResource Brush.ModernTile.Background1}" />
    </Style>

    <Style x:Key="WidgetStandardStyle2"
           TargetType="Panel">
        <Setter Property="Background"
                Value="{StaticResource Brush.ModernTile.Background2}" />
    </Style>

    <Style x:Key="WidgetStandardStyle3"
           TargetType="Panel">
        <Setter Property="Background"
                Value="{StaticResource Brush.ModernTile.Background3}" />
    </Style>
</ResourceDictionary>
