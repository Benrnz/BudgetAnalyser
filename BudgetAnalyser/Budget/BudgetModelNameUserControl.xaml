<UserControl x:Class="BudgetAnalyser.Budget.BudgetModelNameUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:budget="clr-namespace:BudgetAnalyser.Budget"
             Background="{StaticResource Brush.MainBackground}">

    <!-- DataContext must be BudgetCurrencyContext. The name is only a rename link when RenameCommand is set. Without a
         command the TextBlock is not hit-testable, so the link never shows hover, the hand cursor or the tooltip. -->
    <StackPanel Orientation="Horizontal">
        <TextBlock>
            <TextBlock.Style>
                <Style TargetType="TextBlock"
                       BasedOn="{StaticResource TextBlock.PageTitle}">
                    <Setter Property="ToolTip"
                            Value="Click to rename" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding RenameCommand, RelativeSource={RelativeSource AncestorType=budget:BudgetModelNameUserControl}}"
                                     Value="{x:Null}">
                            <Setter Property="IsHitTestVisible"
                                    Value="False" />
                            <Setter Property="ToolTip"
                                    Value="{x:Null}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
            <Hyperlink Command="{Binding RenameCommand, RelativeSource={RelativeSource AncestorType=budget:BudgetModelNameUserControl}}">
                <Run Text="{Binding Model.Name, Mode=OneWay}" />
            </Hyperlink>
        </TextBlock>

        <!-- Status chips are informational, so they use the outlined chip style (see the UX guide) -->
        <Border Margin="16,0,8,0"
                Style="{StaticResource Border.SummaryChip.Info}"
                ToolTip="The pay cycle for this budget.">
            <TextBlock Margin="0"
                       Foreground="{StaticResource Brush.Text.Default}"
                       Style="{StaticResource TextBlock.SummaryChip.Info.Label}"
                       Text="{Binding Model.BudgetCycle}" />
        </Border>
        <Border Style="{StaticResource Border.SummaryChip.Info}"
                ToolTip="This budget is the current active budget for today."
                Visibility="{Binding BudgetActive, Converter={StaticResource Converter.BoolToVis}}">
            <TextBlock Margin="0"
                       Foreground="{StaticResource Brush.Positive.Text}"
                       Style="{StaticResource TextBlock.SummaryChip.Info.Label}"
                       Text="Active" />
        </Border>
        <Border Style="{StaticResource Border.SummaryChip.Info}"
                ToolTip="This budget is old, and is not current for today's or future transactions."
                Visibility="{Binding BudgetArchived, Converter={StaticResource Converter.BoolToVis}}">
            <TextBlock Margin="0"
                       Style="{StaticResource TextBlock.SummaryChip.Info.Label}"
                       Text="Archived" />
        </Border>
        <Border Style="{StaticResource Border.SummaryChip.Info}"
                ToolTip="This budget is a future dated budget and has not yet being applied to transactions."
                Visibility="{Binding BudgetInFuture, Converter={StaticResource Converter.BoolToVis}}">
            <TextBlock Margin="0"
                       Foreground="{StaticResource Brush.Primary}"
                       Style="{StaticResource TextBlock.SummaryChip.Info.Label}"
                       Text="Future" />
        </Border>
    </StackPanel>
</UserControl>
